generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Seller {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  name      String
  balance   Int?
  phone     String?   @unique
  whatsapp  String?
  password  String    @default("pending")
  products  Product[]
  latitude  Float?
  longitude Float?
}

model Product {
  id                Int                 @id @default(autoincrement())
  name              String
  image             String
  description       String?
  price             Int
  createdAt         DateTime            @default(now())
  updatedAt         DateTime?
  owner             Seller?             @relation(fields: [ownerId], references: [id])
  ownerId           Int
  isOrdered         Boolean             @default(false)
  isBought          Boolean             @default(false)
  cartItems         CartItem[]
  orderItems        OrderItem[]
  buyerNotification BuyerNotification[]
}

model CartItem {
  id        Int     @id @default(autoincrement())
  productId Int
  buyerId   Int
  quantity  Int
  product   Product @relation(fields: [productId], references: [id])
  buyer     Buyer   @relation(fields: [buyerId], references: [id])

  @@unique([buyerId, productId])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  buyerId   Int
  productId Int
  quantity  Int
  product   Product @relation(fields: [productId], references: [id])
  buyer     Buyer   @relation(fields: [buyerId], references: [id])
}

model Buyer {
  id                Int                 @id @default(autoincrement())
  name              String
  email             String              @unique
  password          String              @default("pending")
  phone             String?             @unique
  whatsapp          String?
  balance           Int?
  latitude          Float?
  longitude         Float?
  cartItem          CartItem[]
  orderItems        OrderItem[]
  buyerNotification BuyerNotification[]
}

model BuyerNotification {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  meta      Json

  user    Buyer   @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}
